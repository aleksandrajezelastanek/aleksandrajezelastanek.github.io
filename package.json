{
  "name": "jezela-stanek-academic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:preview": "NEXT_PUBLIC_CONTENT_PREVIEW=1 next dev",
    "dev:en": "NEXT_PUBLIC_ENABLE_EN=1 next dev",
    "build": "next build",
    "build:preview": "NEXT_PUBLIC_CONTENT_PREVIEW=1 next build",
    "serve": "node scripts/serve.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.ts",
    "test": "vitest run",
    "test:build": "vitest run --config vitest.build.config.ts",
    "verify": "npm run typecheck && npm run lint && npm run check:content && npm test && npm run build && npm run test:build",
    "format": "prettier --write src scripts tests"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
